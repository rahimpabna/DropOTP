# ==============================================================================
# Global Configuration
# ==============================================================================
NODE_ENV=production
PORT=4000
BASE_URL=https://dropotp.com
API_URL=https://dropotp.com/api
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
ADMIN_EMAIL=admin@dropotp.com
ADMIN_PASSWORD=Sh330717@

# ==============================================================================
# Database & Cache
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_strong_password_change_me
POSTGRES_DB=otp_platform
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_change_me
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ==============================================================================
# Inbound SMTP Server (Port 25)
# ==============================================================================
SMTP_PORT=25
SMTP_DOMAIN=dropotp.com
# Upstream proxy for incoming/outgoing if required (e.g., socks5://127.0.0.1:1080)
SMTP_PROXY_URL=

# ==============================================================================
